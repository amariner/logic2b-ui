{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.logic2b.com/schema/behavior.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "states": {
      "type": "object",
      "properties": {
        "loading": {
          "type": "object",
          "properties": {
            "support": {
              "enum": [
                "built-in",
                "consumer",
                "not-applicable"
              ]
            },
            "how": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "support",
            "how",
            "transition"
          ],
          "additionalProperties": false
        },
        "empty": {
          "type": "object",
          "properties": {
            "support": {
              "enum": [
                "built-in",
                "consumer",
                "not-applicable"
              ]
            },
            "how": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "support",
            "how",
            "transition"
          ],
          "additionalProperties": false
        },
        "no-results": {
