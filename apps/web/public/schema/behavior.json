        "partial": {
          "type": "object",
          "properties": {
            "support": {
              "enum": [
                "built-in",
                "consumer",
                "not-applicable"
              ]
            },
            "how": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
              "type": "string",
              "minLength": 1
