      "required": [
        "loading",
        "empty",
        "no-results",
        "error",
        "success",
        "submitting",
        "validation-error",
        "permission-denied",
        "unsaved-changes",
        "offline",
        "partial"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "text"
          },
          "sample": {
            "type": "string",
            "minLength": 1
          },
          "guidance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "path",
          "type",
          "sample"
        ],
        "additionalProperties": false
      }
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "browse-customers",
          "filter-customers",
          "create-customer",
          "edit-customer"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "callback": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "callback",
          "responsibility"
        ],
        "additionalProperties": false
      }
    },
    "journey": {
      "type": "object",
      "properties": {
        "before": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "responsive": {
      "type": "object",
      "properties": {
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "mobile",
              "tablet",
              "desktop"
            ]
          }
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "touchTargets": {
          "const": "44px"
        }
      },
      "required": [
        "viewports",
        "strategy",
        "touchTargets"
      ],
      "additionalProperties": false
    },
    "consumer": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "states",
    "content",
    "intents",
    "actions",
    "journey",
    "responsive",
    "consumer"
  ],
  "additionalProperties": false
}