            "transition"
          ],
          "additionalProperties": false
        },
        "error": {
          "type": "object",
          "properties": {
            "support": {
              "enum": [
                "built-in",
                "consumer",
                "not-applicable"
              ]
            },
            "how": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "support",
            "how",
            "transition"
          ],
          "additionalProperties": false
        },
        "success": {
          "type": "object",
          "properties": {
            "support": {
              "enum": [
                "built-in",
                "consumer",
                "not-applicable"
              ]
            },
            "how": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "support",
            "how",
            "transition"
          ],
          "additionalProperties": false
        },
        "submitting": {
          "type": "object",
          "properties": {
            "support": {
              "enum": [
                "built-in",
                "consumer",
                "not-applicable"
              ]
            },
            "how": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "support",
            "how",
            "transition"
          ],
          "additionalProperties": false
        },
        "validation-error": {
          "type": "object",
          "properties": {
            "support": {
              "enum": [
                "built-in",
                "consumer",
                "not-applicable"
              ]
            },
            "how": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
