              "enum": [
                "built-in",
                "consumer",
                "not-applicable"
              ]
            },
            "how": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "support",
            "how",
            "transition"
          ],
          "additionalProperties": false
        },
        "unsaved-changes": {
          "type": "object",
          "properties": {
            "support": {
              "enum": [
                "built-in",
                "consumer",
                "not-applicable"
              ]
            },
            "how": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "support",
            "how",
            "transition"
          ],
          "additionalProperties": false
        },
        "offline": {
          "type": "object",
          "properties": {
