{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.logic2b.com/schema/registry-changelog.json",
  "title": "logic2b item changelog",
  "type": "object",
  "required": ["schemaVersion", "name", "currentVersion", "changes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string" },
    "currentVersion": { "type": "string" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "releasedAt", "kind", "summary"],
        "properties": {
          "version": { "type": "string" },
          "releasedAt": { "type": "string", "format": "date" },
          "kind": {
            "enum": ["baseline", "added", "changed", "fixed", "deprecated", "removed"]
          },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
