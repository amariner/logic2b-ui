{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.logic2b.com/schema/registry-item.json",
  "title": "logic2b registry item",
  "type": "object",
  "required": ["name", "type", "description"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "pattern": "^registry:" },
    "title": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "registryDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "content"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string", "pattern": "^registry:" },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "categories": { "type": "array", "items": { "type": "string" } },
    "docs": { "type": "string" },
    "cssVars": { "type": "object" },
    "css": { "type": "object" },
    "accessibility": { "$ref": "https://ui.logic2b.com/schema/accessibility.json" },
    "api": {
      "type": "object",
      "required": ["source", "exports"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "exports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "kind"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["component", "hook", "type", "utility"] },
              "description": { "type": "string" },
              "propsType": { "type": "string" },
              "props": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type", "required"],
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "required": { "type": "boolean" },
                    "default": { "type": "string" },
                    "description": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "aliasOf": { "type": "string" },
              "definition": { "type": "string" },
              "signature": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
