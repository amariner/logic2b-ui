{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.logic2b.com/schema/registry-versions.json",
  "title": "logic2b registry release index",
  "type": "object",
  "required": ["schemaVersion", "latest", "channels", "versions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "latest": { "type": "string" },
    "channels": { "type": "object", "additionalProperties": { "type": "string" } },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "channel", "releasedAt", "manifest"],
        "properties": {
          "version": { "type": "string" },
          "channel": { "type": "string" },
          "releasedAt": { "type": "string", "format": "date" },
          "manifest": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
