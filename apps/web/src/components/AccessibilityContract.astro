---
import type { RegistryAccessibility } from "@logic2b/registry/types";

interface Props {
  name: string;
  contract: RegistryAccessibility;
  locale?: "en" | "es";
}

const { name, contract, locale = "en" } = Astro.props;
const copy = locale === "es"
  ? {
      title: "Contrato de accesibilidad",
      description: "Comportamiento legible por máquinas y responsabilidades de quien integra",
      canonical: "Los detalles normativos conservan el texto canónico del registro.",
      json: "Ver JSON",
      support: "Soporte",
      pattern: "Patrón",
      caption: "Interacciones de teclado para",
      keys: "Teclas",
      behavior: "Comportamiento",
      builtIn: "Semántica incorporada",
      consumer: "Responsabilidades de integración",
      limitations: "Limitaciones conocidas",
    }
  : {
      title: "Accessibility contract",
      description: "Machine-readable behavior and consumer responsibilities for",
      canonical: "",
      json: "View JSON",
      support: "Support",
      pattern: "Pattern",
      caption: "Keyboard interactions for",
      keys: "Keys",
      behavior: "Behavior",
      builtIn: "Built-in semantics",
      consumer: "Consumer responsibilities",
      limitations: "Known limitations",
    };
const supportLabels = locale === "es"
  ? { native: "Semántica nativa", primitive: "Gestionado por la primitiva", authored: "Comportamiento implementado", consumer: "Contrato de composición" } as const
  : { native: "Native semantics", primitive: "Primitive-managed", authored: "Authored behavior", consumer: "Composition contract" } as const;
---

<section
  aria-labelledby={`accessibility-contract-${name}`}
  class="not-prose mt-12 border-t pt-8"
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2
        class="scroll-mt-24 text-2xl font-semibold tracking-tight"
        id={`accessibility-contract-${name}`}
      >
        {copy.title}
      </h2>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">
        {copy.description} <code>{name}</code>. {copy.canonical}
      </p>
    </div>
    <a
      class="rounded-full border px-3 py-1 text-xs font-medium hover:bg-muted"
      href={`/r/${name}.json#accessibility`}
    >
      {copy.json}
    </a>
  </div>

  <dl class="mt-5 grid gap-3 sm:grid-cols-2">
    <div class="rounded-lg border bg-card p-4">
      <dt class="text-xs font-medium uppercase tracking-wider text-muted-foreground">{copy.support}</dt>
      <dd class="mt-1 text-sm font-medium">{supportLabels[contract.support]}</dd>
    </div>
    <div class="rounded-lg border bg-card p-4">
      <dt class="text-xs font-medium uppercase tracking-wider text-muted-foreground">{copy.pattern}</dt>
      <dd class="mt-1 text-sm font-medium">{contract.pattern}</dd>
      {contract.primitive && <dd class="mt-1 text-xs text-muted-foreground">{contract.primitive}</dd>}
    </div>
  </dl>

  {contract.keyboard.length > 0 && (
    <div class="mt-5 overflow-x-auto rounded-lg border">
      <table class="w-full text-sm">
        <caption class="sr-only">{copy.caption} {name}</caption>
        <thead class="bg-muted/50 text-left">
          <tr>
            <th class="px-3 py-2 font-medium" scope="col">{copy.keys}</th>
            <th class="px-3 py-2 font-medium" scope="col">{copy.behavior}</th>
          </tr>
        </thead>
        <tbody>
          {contract.keyboard.map((interaction) => (
            <tr class="border-t">
              <td class="whitespace-nowrap px-3 py-2 align-top">
                {interaction.keys.map((value, index) => (
                  <><kbd class="rounded border bg-muted px-1.5 py-0.5 font-mono text-xs">{value}</kbd>{index < interaction.keys.length - 1 ? " " : ""}</>
                ))}
              </td>
              <td class="px-3 py-2 text-muted-foreground">{interaction.action}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <div class="mt-5 grid gap-5 lg:grid-cols-2">
    <div>
      <h3 class="text-sm font-semibold">{copy.builtIn}</h3>
      <ul class="mt-2 space-y-2 text-sm leading-6 text-muted-foreground">
        {contract.aria.map((item) => <li class="flex gap-2"><span aria-hidden="true">✓</span><span>{item}</span></li>)}
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold">{copy.consumer}</h3>
      <ul class="mt-2 space-y-2 text-sm leading-6 text-muted-foreground">
        {contract.consumer.map((item) => <li class="flex gap-2"><span aria-hidden="true">→</span><span>{item}</span></li>)}
      </ul>
    </div>
  </div>

  {contract.limitations && (
    <div class="mt-5 rounded-lg border border-amber-500/40 bg-amber-500/5 p-4">
      <h3 class="text-sm font-semibold">{copy.limitations}</h3>
      <ul class="mt-2 space-y-1 text-sm leading-6 text-muted-foreground">
        {contract.limitations.map((item) => <li>• {item}</li>)}
      </ul>
    </div>
  )}
</section>
