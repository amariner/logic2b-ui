---
import type { RegistryBehavior } from "@logic2b/scaffold/behavior";
import { CLI_PACKAGE_SELECTOR } from "@logic2b/scaffold/package-selectors";
import { Code } from "astro:components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildAddPrompt } from "@/lib/prompts";
import registryIndex from "../../../../public/r/index.json";

type RegistryBlock = {
  name: string;
  type: string;
  title?: string;
  description: string;
  categories?: string[];
  behavior?: RegistryBehavior;
};

type RegistryFile = { path: string; type: string; content: string };
type RegistryDetail = { name: string; files?: RegistryFile[] };

const blocks = (registryIndex as RegistryBlock[]).filter(
  (item) => item.type === "registry:block" && !item.categories?.includes("charts"),
);

const detailModules = import.meta.glob<RegistryDetail>("../../../../public/r/*.json", {
  import: "default",
  eager: true,
});

export async function getStaticPaths() {
  const registry = (await import("../../../../public/r/index.json")).default as RegistryBlock[];
  return registry
    .filter((item) => item.type === "registry:block" && !item.categories?.includes("charts"))
    .map((block) => ({
      params: { category: block.categories?.[0] ?? "application", name: block.name },
    }));
}

const { category, name } = Astro.params;
const block = blocks.find((b) => b.name === name)!;
const detail = detailModules[`../../../../public/r/${name}.json`];
const files = detail?.files ?? [];

// Shown code should read like the user's own file — same mapping build-registry.ts
// used going the other way (ui/ and blocks/ live under components/, lib/ doesn't).
const displayPath = (path: string) =>
  path
    .replace(/^ui\//, "components/ui/")
    .replace(/^blocks\//, "components/")
    .replace(/^lib\//, "lib/");

const installCmd = `npx ${CLI_PACKAGE_SELECTOR} add ${name}`;
---

<BaseLayout
  title={`${block.title ?? block.name} — logic2b/ui`}
  description={block.description}
>
  <div class="mx-auto w-full max-w-screen-2xl px-4 py-10 sm:px-6">
    <a href={`/blocks/${category}`} class="text-sm text-muted-foreground hover:text-foreground">
      ← Back to {category} blocks
    </a>

    <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">{block.name}</h1>
        <p class="mt-1 max-w-2xl text-muted-foreground">{block.description}</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <div
          class="viewport-toggle flex items-center gap-0.5 rounded-md border p-0.5"
          data-target={block.name}
        >
          <button data-width="100%" class="viewport-btn btn btn-sm h-7 rounded-sm bg-accent px-2">
            Desktop
          </button>
          <button data-width="768px" class="viewport-btn btn btn-sm h-7 rounded-sm px-2">
            Tablet
          </button>
          <button data-width="375px" class="viewport-btn btn btn-sm h-7 rounded-sm px-2">
            Mobile
          </button>
        </div>
        <button
          class="copy-btn btn btn-sm btn-outline font-mono"
          data-command={installCmd}
          title="Copy install command"
        >
          {installCmd}
        </button>
        <button
          class="copy-btn btn btn-sm btn-outline"
          data-command={buildAddPrompt(name)}
          title="Copy a prompt for your AI assistant"
        >
          Copy Prompt
        </button>
      </div>
    </div>

    {block.behavior && <div role="tablist" aria-label="Block examples" class="mt-6 flex gap-2">
      <button id="preview-tab" role="tab" aria-selected="true" aria-controls="preview-panel" data-example-tab="preview-panel" class="btn btn-outline min-h-11">Preview</button>
      <button id="states-tab" role="tab" aria-selected="false" aria-controls="states-panel" tabindex="-1" data-example-tab="states-panel" class="btn btn-outline min-h-11">States</button>
    </div>}
    <div id="preview-panel" role={block.behavior ? "tabpanel" : undefined} aria-labelledby={block.behavior ? "preview-tab" : undefined}>
    <div class="mt-6 flex justify-center overflow-hidden rounded-xl border bg-muted/20 p-4">
      <iframe
        id={`frame-${block.name}`}
        title={`${block.title ?? block.name} preview`}
        src={`/blocks/preview/${block.name}`}
        class="h-[720px] w-full rounded-lg border bg-background transition-[width] duration-200"
        loading="lazy"
      />
    </div>

    </div>
    {block.behavior && <section id="states-panel" role="tabpanel" aria-labelledby="states-tab" class="mt-6 space-y-6" hidden>
      <h2 class="text-lg font-semibold">States and transitions</h2>
      {Object.entries(block.behavior.states).map(([state, contract]) => <article class="space-y-3 rounded-lg border p-4">
        <h3 class="font-semibold">{state} <span class="text-sm font-normal text-muted-foreground">({contract.support})</span></h3>
        <p>{contract.how}</p><p class="text-sm text-muted-foreground">{contract.transition}</p>
        {contract.support === "built-in" && <iframe title={`${block.name}: ${state}`} src={`/blocks/preview/${block.name}?state=${state}`} class="h-[640px] w-full rounded border" loading="lazy" />}
      </article>)}
      <h2 class="text-lg font-semibold">Content slots</h2>
      <div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr><th class="p-2">Path</th><th class="p-2">Sample</th></tr></thead><tbody>{block.behavior.content.map(slot => <tr><td class="p-2"><code>{slot.path}</code></td><td class="p-2">{slot.sample}</td></tr>)}</tbody></table></div>
      <h2 class="text-lg font-semibold">Consumer responsibilities</h2>
      <ul class="list-disc space-y-2 pl-6">{block.behavior.consumer.map(note => <li>{note}</li>)}</ul>
    </section>}

    {
      files.length > 0 && (
        <div class="mt-10">
          <h2 class="mb-3 text-lg font-semibold">Code</h2>
          <div class="flex items-center gap-1 overflow-x-auto border-b">
            {files.map((file, i) => (
              <button
                class:list={[
                  "file-tab -mb-px shrink-0 border-b-2 px-3 py-1.5 font-mono text-xs",
                  i === 0
                    ? "border-primary text-foreground"
                    : "border-transparent text-muted-foreground hover:text-foreground",
                ]}
                data-file={file.path}
              >
                {displayPath(file.path)}
              </button>
            ))}
          </div>
          {files.map((file, i) => (
            <div
              class:list={["file-panel", i !== 0 && "hidden"]}
              data-file={file.path}
            >
              <div class="max-h-[520px] overflow-auto rounded-b-lg border border-t-0 [&_pre]:m-0 [&_pre]:rounded-none [&_pre]:border-0 [&_pre]:p-4">
                <Code code={file.content} lang="tsx" theme="github-dark-default" />
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

<script>
  const exampleTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-example-tab]"));
  function selectExample(tab: HTMLButtonElement) {
    exampleTabs.forEach(button => {
      const selected = button === tab;
      button.setAttribute("aria-selected", String(selected));
      button.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(button.dataset.exampleTab!);
      if (panel) panel.hidden = !selected;
    });
  }
  exampleTabs.forEach((tab, i) => {
    tab.addEventListener("click", () => selectExample(tab));
    tab.addEventListener("keydown", event => {
      if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
      event.preventDefault();
      const next = exampleTabs[event.key === "Home" ? 0 : event.key === "End" ? exampleTabs.length - 1 : (i + (event.key === "ArrowRight" ? 1 : -1) + exampleTabs.length) % exampleTabs.length];
      selectExample(next); next.focus();
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const command = btn.dataset.command;
      if (!command) return;
      await navigator.clipboard.writeText(command);
      const original = btn.textContent;
      btn.textContent = "Copied!";
      setTimeout(() => {
        btn.textContent = original;
      }, 1500);
    });
  });

  document
    .querySelectorAll<HTMLDivElement>(".viewport-toggle")
    .forEach((group) => {
      const target = group.dataset.target;
      const frame = document.getElementById(
        `frame-${target}`
      ) as HTMLIFrameElement | null;
      const buttons = group.querySelectorAll<HTMLButtonElement>(".viewport-btn");
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          if (!frame) return;
          frame.style.width = btn.dataset.width ?? "100%";
          buttons.forEach((b) => b.classList.remove("bg-accent"));
          btn.classList.add("bg-accent");
        });
      });
    });

  const fileTabs = document.querySelectorAll<HTMLButtonElement>(".file-tab");
  const filePanels = document.querySelectorAll<HTMLDivElement>(".file-panel");
  fileTabs.forEach((btn) => {
    btn.addEventListener("click", () => {
      fileTabs.forEach((b) => {
        const active = b === btn;
        b.classList.toggle("border-primary", active);
        b.classList.toggle("text-foreground", active);
        b.classList.toggle("border-transparent", !active);
        b.classList.toggle("text-muted-foreground", !active);
      });
      filePanels.forEach((panel) => {
        panel.classList.toggle("hidden", panel.dataset.file !== btn.dataset.file);
      });
    });
  });
</script>
