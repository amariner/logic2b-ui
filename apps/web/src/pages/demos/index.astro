---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { LAUNCH_DEMOS } from "@/data/launch-demos"
---

<BaseLayout
  title="Live starter demos — logic2b ui"
  description="Explore complete marketing, dashboard and authentication starters generated by the logic2b CLI and shell-less MCP tools."
>
  <main class="mx-auto w-full max-w-[1600px] px-4 py-12 sm:px-6 lg:py-16">
    <header class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">
        Runnable starters
      </p>
      <h1 class="mt-4 text-balance text-4xl font-bold tracking-tight sm:text-5xl">
        Start from a real product surface
      </h1>
      <p class="mt-5 text-balance text-lg leading-8 text-muted-foreground">
        These are the same block compositions emitted by the CLI and MCP
        scaffold tools—not separate marketing mockups. Open a live demo, then
        generate its editable source with one command.
      </p>
    </header>

    <div class="mt-12 grid gap-8 xl:grid-cols-2">
      {LAUNCH_DEMOS.map((demo, index) => (
        <article
          class:list={[
            "group overflow-hidden rounded-2xl border bg-card shadow-sm",
            index === 0 && "xl:col-span-2",
          ]}
        >
          <div class:list={["h-1 bg-gradient-to-r", demo.accent]}></div>
          <div class="flex flex-col gap-5 p-5 sm:flex-row sm:items-start sm:justify-between sm:p-6">
            <div class="max-w-2xl">
              <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                {demo.items.length} registry {demo.items.length === 1 ? "block" : "blocks"}
              </p>
              <h2 class="mt-2 text-2xl font-semibold tracking-tight">{demo.title}</h2>
              <p class="mt-2 leading-7 text-muted-foreground">{demo.description}</p>
            </div>
            <a
              href={demo.previewHref}
              class="btn btn-primary shrink-0"
              aria-label={`Open ${demo.title} live demo`}
            >
              Open live demo
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </a>
          </div>

          <div class:list={["relative overflow-hidden border-y bg-gradient-to-br", demo.accent]}>
            <iframe
              src={demo.previewHref}
              title={`${demo.title} starter preview`}
              loading={index === 0 ? "eager" : "lazy"}
              class:list={[
                "block w-full bg-background",
                index === 0 ? "h-[34rem]" : "h-[30rem]",
              ]}
            ></iframe>
          </div>

          <div class="p-5 sm:p-6">
            <p class="mb-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
              Create the Vite starter
            </p>
            <div class="flex min-w-0 items-stretch">
              <div
                class="min-w-0 flex-1 overflow-x-auto rounded-l-lg border border-r-0 bg-muted/40 px-4 py-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                role="region"
                aria-label={`${demo.title} creation command`}
                tabindex="0"
              >
                <code class="whitespace-nowrap font-mono text-xs sm:text-sm">{demo.command}</code>
              </div>
              <button
                type="button"
                class="shrink-0 rounded-r-lg border bg-background px-3 text-xs font-medium transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                aria-label={`Copy ${demo.title} creation command`}
                data-copy-command={demo.command}
              >
                Copy
              </button>
            </div>
            <ul class="mt-4 flex flex-wrap gap-2" aria-label={`${demo.title} registry items`}>
              {demo.items.map((item) => (
                <li class="rounded-full border bg-background px-2.5 py-1 font-mono text-xs text-muted-foreground">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <section class="mt-12 rounded-2xl border bg-muted/30 p-6 text-center sm:p-10">
      <h2 class="text-2xl font-semibold tracking-tight">Make any starter yours</h2>
      <p class="mx-auto mt-3 max-w-2xl leading-7 text-muted-foreground">
        Choose an exact theme in the studio, then pass its preset id to the CLI
        or MCP scaffold. Components, tokens and the update manifest stay aligned.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/create" class="btn btn-primary">Create a theme</a>
        <a href="/docs/integration-paths" class="btn btn-outline">Compare install paths</a>
      </div>
    </section>
  </main>
  <script>
    async function copyText(text: string): Promise<boolean> {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text)
          return true
        }
      } catch {
        // Sandboxed previews and some browsers deny the async clipboard API.
      }

      const textarea = document.createElement("textarea")
      textarea.value = text
      textarea.readOnly = true
      textarea.style.position = "fixed"
      textarea.style.left = "-9999px"
      document.body.append(textarea)
      textarea.select()
      const copied = document.execCommand("copy")
      textarea.remove()
      return copied
    }

    document.querySelectorAll<HTMLButtonElement>("[data-copy-command]").forEach((button) => {
      button.addEventListener("click", async () => {
        const command = button.dataset.copyCommand
        if (!command) return

        if (!(await copyText(command))) return
        button.textContent = "Copied"
        window.setTimeout(() => {
          button.textContent = "Copy"
        }, 1_500)
      })
    })
  </script>
</BaseLayout>
