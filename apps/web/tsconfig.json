{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@/registry/*": ["../../packages/registry/src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src",
    "../../packages/registry/src",
    "../../packages/mcp/src/semver.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
