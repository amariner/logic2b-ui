8\",\"registryVersion\":\"1.0.0-rc.16\",\"integrity\":\"sha256-uhQeI+OzUhWxttJQHAH9VJJQRa3Pjqd72udjjlPThM4=\",\"content\":\"/r/content/ba141e23e3b35215b1b6d2501c01fd54925045adcf8ea77bdae7638\n1:son\",\"accessibility\":\"/r/textarea.json#accessibility\",\"api\":\"/r/textarea.json#api\"},{\"name\":\"accordion\",\"type\":\"registry:ui\",\"description\":\"A vertically stacked set of interactive headings that each reveal a section of content, built on Radix Accordion. Use it for FAQs or collapsible content groups. Parts: Accordion (root, supports type 'single' or 'multiple'), AccordionItem, AccordionTrigger, AccordionContent.\",\"categories\n1:nter or comma commits, paste splits on commas, Backspace on an empty field removes the last tag, duplicates are ignored and max caps the list. Controlled or uncontrolled via value/defaultValue + onValueChange.\",\"categories\":[\"form\"],\"version\":\"1.0.0-rc.8\",\"registryVersion\":\"1.0.0-rc.16\",\"integrity\":\"sha256-Iw2ILvfSrLiO5rdUfdwS5iX3Gfn/JgVJCV0NC2WhUMY=\",\"content\":\"/r/content/230d882ef7d2acb88ee6b7547ddc12e625f719f9ff260549095\n1:stry:ui\",\"title\":\"Number Field\",\"description\":\"A numeric input with decrement/increment steppers, min/max clamping and step. Controlled via value/onValueChange or uncontrolled via defaultValue. Renders a real <input type=number> (native form submission + keyboard) with the native spinners hidden in favor of the styled buttons.\",\"categories\":[\"form\"],\"version\":\"1.0.0-rc.8\",\"registryVersion\":\"1.0.0-rc.16\",\"integrity\":\"sha256-\n1:r Picker\",\"description\":\"A self-contained HSV color picker: a draggable saturation/value area, a hue slider and a hex input. Controlled via value/onValueChange or uncontrolled via defaultValue; emits #rrggbb. Pointer-driven, zero dependencies.\",\"categories\":[\"form\"],\"version\":\"1.0.0-rc.8\",\"registryVersion\":\"1.0.0-rc.16\",\"integrity\":\"sha256-pwMfDvwJ6vSxHguMp7vezyntcgSx7ZIfpb+O0wEGDOw=\",\"content\":\"/r/content/a7031f0efc09eaf4b\n1:holder with an icon, title, description and actions. Use for empty lists, search results with no matches or first-run states. Parts: Empty (root), EmptyHeader, EmptyMedia (variant default | icon), EmptyTitle, EmptyDescription, EmptyContent.\",\"categories\":[\"feedback\"],\"version\":\"1.0.0-rc.8\",\"registryVersion\":\"1.0.0-rc.16\",\"integrity\":\"sha256-Gy6b4bBFpm++dYKSf+eRt0OZ/92wgGeBBisimzfxOKc=\",\"content\":\"/r/content/1b2e9be1b045a66f\n1:egistry:ui\",\"title\":\"Motion\",\"description\":\"Enter/exit/hover animation recipes on tokens, built on tw-animate-css (zero runtime deps). Ships the <Motion> primitive (plays an enter preset on mount, with duration/delay/hover props and asChild) plus the recipe maps and helpers (motionEnter, motionExit, motionHover) to drop the same effects onto any element or a Radix data-[state] node. Presets: fade, fade-up/down/left/right, \n1:essibility\",\"api\":\"/r/motion.json#api\"},{\"name\":\"motion-fade\",\"type\":\"registry:ui\",\"title\":\"Motion Fade\",\"description\":\"Fade a mounting element in — the preconfigured <MotionFade> preset built on the motion engine. Zero runtime deps (tw-animate-css).\",\"categories\":[\"motion\"],\"version\":\"1.0.0-rc.8\",\"registryVersion\":\"1.0.0-rc.16\",\"integrity\":\"sha256-vVQ83So4J9NUPXeu4EKJBwAuThBgTWQ7og606vy4jz4=\",\"content\":\"/r/content/bd543cd\n1:ame\":\"motion-slide\",\"type\":\"registry:ui\",\"title\":\"Motion Slide\",\"description\":\"Slide a mounting element in from a direction (up/down/left/right) while it fades — the <MotionSlide> preset built on the motion engine. Zero runtime deps (tw-animate-css).\",\"categories\":[\"motion\"],\"version\":\"1.0.0-rc.8\",\"registryVersion\":\"1.0.0-rc.16\",\"integrity\":\"sha256-XjNUxx6MMjrdroWhc/ThiqJlkP5qBayWVrWVQLPZre0=\",\"content\":\"/r/content/5e3354c\n1:/r/motion-slide.json#api\"},{\"name\":\"motion-scale\",\"type\":\"registry:ui\",\"title\":\"Motion Scale\",\"description\":\"Zoom a mounting element in from 95% while it