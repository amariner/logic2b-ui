true,\n+    \"lib\": [\n+      \"ES2022\",\n+      \"DOM\",\n+      \"DOM.Iterable\"\n+    ],\n+    \"allowJs\": false,\n+    \"skipLibCheck\": true,\n+    \"esModuleInterop\": true,\n+    \"allowSyntheticDefaultImports\": true,\n+    \"strict\": true,\n+    \"forceConsistentCasingInFileNames\": true,\n+    \"module\": \"ESNext\",\n+    \"moduleResolution\": \"Bundler\",\n+    \"resolveJsonModule\": true,\n+    \"isolatedModules\": true,\n+    \"noEmit\": true,\n+    \"jsx\": \"react-jsx\",\n+    \"paths\": {\n+      \"@/*\": [\n+        \"./src/*\"\n+      ]\n+    }\n+  },\n+  \"include\": [\n+    \"src\"\n+  ]\n+}\n*** Add File: vite.config.ts\n+import path from \"node:path\"\n+import react from \"@vitejs/plugin-react\"\n+import tailwindcss from \"@tailwindcss/vite\"\n+import { defineConfig } from \"vite\"\n+\n+export default defineConfig({\n+  plugins: [react(), tailwindcss()],\n+  resolve: { alias: { \"@\": path.resolve(import.meta.dirname, \"./src\") } },\n+\n+  build: {\n+    rolldownOptions: {\n+      output: {\n+        codeSplitting: {\n+          groups: [\n+            {\n+              name: \"charts\",\n+              test: /node_modules[\\\\/](?:recharts|victory-vendor|d3-|react-smooth|decimal\\.js-light)/,\n+              includeDependenciesRecursively: false,\n+            },\n+          ],\n+        },\n+      },\n+    },\n+  },\n+})\n*** Add File: index.html\n+<!doctype html>\n+<html lang=\"en\" class=\"dark\">\n+  <head>\n+    <meta charset=\"UTF-8\" />\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n+    <title>logic2b starter</title>\n+  </head>\n+  <body>\n+    <div id=\"root\"></div>\n+    <script type=\"module\" src=\"/src/main.tsx\"></script>\n+  </body>\n+</html>\n*** Add File: src/main.tsx\n+import { StrictMode } from \"react\"\n+import { createRoot } from \"react-dom/client\"\n+\n+import { StarterPage } from \"@/components/starter-page\"\n+import \"@/styles/theme.css\"\n+\n+createRoot(document.getElementById(\"root\")!).render(\n+  <StrictMode>\n+    <StarterPage />\n+  </StrictMode>\n+)\n*** Add File: src/vite-env.d.ts\n+/// <reference types=\"vite/client\" />\n*** Add File: src/components/starter-page.tsx\n+import { lazy, Suspense } from \"react\"\n+\n+const AnalyticsDashboard = lazy(() =>\n+  import(\"@/components/dashboard-02/analytics-dashboard\").then((module) => ({\n+    default: module.AnalyticsDashboard,\n+  }))\n+)\n+\n+export function StarterPage() {\n+  return (\n+    <main className=\"min-h-screen bg-background p-4 text-foreground sm:p-6\">\n+      <Suspense\n+        fallback={\n+          <div className=\"grid min-h-[24rem] place-items-center text-sm text-muted-foreground\" role=\"status\">\n+            Loading dashboard…\n+          </div>\n+        }\n+      >\n+        <AnalyticsDashboard />\n+      </Suspense>\n+    </main>\n+  )\n+}\n*** Add File: .gitignore\n+node_modules\n+dist\n+.env.local\n*** Add File: README.md\n+# scaffold-dashboard\n+\n+Generated by logic2b ui.\n*** Add File: components.json\n+{\n+  \"$schema\": \"https://ui.logic2b.com/schema.json\",\n+  \"style\": \"default\",\n+  \"tailwind\": {\n+    \"css\": \"src/styles/theme.css\",\n+    \"baseColor\": \"neutral\",\n+    \"cssVariables\": true\n+  },\n+  \"aliases\": {\n+    \"components\": \"@/components\",\n+    \"ui\": \"@/components/ui\",\n+    \"utils\": \"@/lib/utils\",\n+    \"hooks\": \"@/hooks\",\n+    \"lib\": \"@/lib\"\n+  },\n+  \"iconLibrary\": \"lucide\",\n+  \"logic2b\": {\n+    \"registry\": \"https://ui.logic2b.com\",\n+    \"preset\": \"bmV1dHJhbHxibHVlfHZpb2xldHx4bHxpbnRlcnxncm90ZXNrfG1vbm98ZGVmYXVsdHxkZWZhdWx0fGRlZmF1bHR8ZGVmYXVsdHxsdWNpZGU\"\n+  }\n+}\n*** Add File: .logic2b/manifest.json\n+{\n+  \"schemaVersion\": 1,\n+  \"registry\": {\n+    \"url\": \"https://ui.logic2b.com\"\n+  },\n+  \"items\": {\n+    \"card\": {\n+      \"files\": [\n+        \"ui/card.tsx\"\n+      ]\n+    },\n+    \"chart\": {\n+      \"files\": [\n+        \"ui/chart.tsx\"\n+      ]\n+    },\n+    \"chart-area-04\": {\n+      \"files\": [\n+        \"charts/chart-area-04.tsx\"\n+      ]\n+    },\n+    \"chart-bar-04\": {\n+      \"files\": [\n+        \"charts/chart-bar-04.tsx\"\n+      ]\n+    },\n+    \"chart-pie-03\": {\n+      \"files\": [\n+        \"charts/chart-pie-03.tsx\"\n+      ]\n+    },\n+    \"chart-radial-02\": {\n+      \"files\": [\n+        \"charts/chart-radial-02.tsx\"\n+      ]\n+    },\n+    \"dashboard-02\": {\n+      \"files\": [\n+        \"blocks/dashboard-02/analytics-dashboard.tsx\"\n+      ]\n+    },\n+    \"select\": {\n+      \"files\": [\n+        \"ui/select.tsx\"\n+      ]\n+    },\n+    \"theme\": {\n+      \"files\": [\n+        \"theme.css\"\n+      ]\n+    },\n+    \"utils\": {\n+      \"files\": [\n+        \"lib/utils.ts\"\n+      ]\n+    }\n+  }\n+}\n*** Add File: .logic2b/base/blocks/dashboard-02/analytics-dashboard.tsx\n+import * as React from \"react\"\n+import { TrendingDownIcon, TrendingUpIcon } from \"lucide-react\"\n+\n+import { cn } from \"@/lib/utils\"\n+import {\n+  Card,\n+  CardContent,\n+  CardDescription,\n+  CardHeader,\n+  CardTitle,\n+} from \"@/components/ui/card\"\n+import ChartArea04 from \"@/components/charts/chart-area-04\"\n+import ChartBar04 from \"@/components/charts/chart-bar-04\"\n+import ChartPie03 from \"@/components/charts/chart-pie-03\"\n+import ChartRadial02 from \"@/components/charts/chart-radial-02\"\n+\n+const stats = [\n+  { label: \"Total revenue\", value: \"$45,231.89\", delta: \"+20.1%\", up: true },\n+  { label: \"Subscriptions\", value: \"2,350\", delta: \"+180.1%\", up: true },\n+  { label: \"Active now\", value: \"573\", delta: \"+201\", up: true },\n+  { label: \"Churn\", value: \"1.2%\", delta: \"-0.4%\", up: false },\n+]\n+\n+export function AnalyticsDashboard({\n+  className,\n+  ...props\n+}: React.ComponentProps<\"div\">) {\n+  return (\n+    <div\n+      className={cn(\"mx-auto w-full max-w-6xl px-6 py-10\", className)}\n+      {...props}\n+    >\n+      <div className=\"mb-6\">\n+        <h1 className=\"font-heading text-2xl font-bold tracking-tight\">\n+          Analytics\n+        </h1>\n+        <p className=\"text-muted-foreground mt-1 text-sm\">\n+          A snapshot of performance across the last quarter.\n+        </p>\n+      </div>\n+\n+      <div className=\"mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4\">\n+        {stats.map((stat) => {\n+          const Icon = stat.up ? TrendingUpIcon : TrendingDownIcon\n+          return (\n+            <Card key={stat.label}>\n+              <CardHeader className=\"pb-2\">\n+                <CardDescription>{stat.label}</CardDescription>\n+                <CardTitle className=\"font-heading text-2xl tracking-tight tabular-nums\">\n+                  {stat.value}\n+                </CardTitle>\n+              </CardHeader>\n+              <CardContent>\n+                <p className=\"text-muted-foreground flex items-center gap-1 text-xs\">\n+                  <Icon className=\"text-foreground size-3.5\" />\n+                  <span className=\"text-foreground font-medium\">\n+                    {stat.delta}\n+                  </span>\n+                  vs last month\n+                </p>\n+              </CardContent>\n+            </Card>\n+          )\n+        })}\n+      </div>\n+\n+      <div className=\"grid gap-4 lg:grid-cols-2\">\n+        <div className=\"lg:col-span-2\">\n+          <ChartArea04 />\n+        </div>\n+        <ChartBar04 />\n+        <div className=\"grid gap-4 sm:grid-cols-2\">\n+          <ChartPie03 />\n+          <ChartRadial02 />\n+        </div>\n+      </div>\n+    </div>\n+  )\n+}\n*** Add File: .logic2b/base/theme.css\n+@import \"tailwindcss\";\n+@import \"tw-animate-css\";\n+@import \"@fontsource-variable/inter\";\n+@import \"@fontsource-variable/space-grotesk\";\n+\n+@custom-variant dark (&:is(.dark *));\n+\n+/* logic2b ui — engineered darkness, monochrome discipline.\n+   Dark-first, light fully supported. Full reference