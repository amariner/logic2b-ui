{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen Logic2b outcome v2 cohort",
  "description": "cohorts.json is an array of these manifests. Freeze before outcomes; runtime verifies exact protocol digest and deterministic schedule entries. Digests identify trusted evaluator inputs; they do not authenticate provenance.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "cohortId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "protocolSha256": {
      "type": "string",
      "pattern": "^sha256-[a-f0-9]{64}$"
    },
    "pins": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "documentationSha256": {
          "type": "string",
          "pattern": "^sha256-[a-f0-9]{64}$"
        },
        "registrySha256": {
          "type": "string",
          "pattern": "^sha256-[a-f0-9]{64}$"
        },
        "rubricSha256": {
          "type": "string",
          "pattern": "^sha256-[a-f0-9]{64}$"
        },
        "browser": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "commit",
        "documentationSha256",
        "registrySha256",
        "rubricSha256",
        "browser"
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "protocolVersion": {
          "const": "2.0.0"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "repetitions": {
          "type": "integer",
          "minimum": 5,
          "maximum": 100
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "conditionId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "taskId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "repetition": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "availability": {
                "enum": [
                  "available",
                  "planned"
                ]
              }
            },
            "required": [
              "order",
              "conditionId",
              "taskId",
              "repetition",
              "availability"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "schemaVersion",
        "protocolVersion",
        "seed",
        "repetitions",
        "entries"
      ],
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "properties": {
        "host": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            "versionKind": {
              "enum": [
                "alias",
                "immutable"
              ]
            }
          },
          "required": [
            "name",
            "version",
            "versionKind"
          ],
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "properties": {
            "os": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            "node": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            }
          },
          "required": [
            "os",
            "node"
          ],
          "additionalProperties": false
        },
        "versions": {
          "type": "object",
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
            },
            "cli": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
            },
            "mcp": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
            },
            "toolSchema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            }
          },
          "required": [
            "registry",
            "cli",
            "mcp",
            "toolSchema"
          ],
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "properties": {
            "elapsedMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "toolCalls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "inputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "outputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "tokens": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "const": "unavailable"
                }
              ]
            }
          },
          "required": [
            "elapsedMs",
            "toolCalls",
            "inputBytes",
            "outputBytes",
            "tokens"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "network": {
              "type": "boolean"
            },
            "shell": {
              "type": "boolean"
            },
            "mcp": {
              "type": "boolean"
            }
          },
          "required": [
            "network",
            "shell",
            "mcp"
          ],
          "additionalProperties": false
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256-[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "sha256"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "host",
        "model",
        "environment",
        "versions",
        "budget",
        "capabilities",
        "fixtures"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "cohortId",
    "protocolSha256",
    "pins",
    "schedule",
    "controls"
  ],
  "additionalProperties": false
}
