{
  "name": "logic2b-ui-monorepo",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:release-artifacts": "pnpm --filter @logic2b/mcp test:release-artifacts",
    "benchmark:frameworks": "pnpm --dir benchmarks/frameworks benchmark",
    "benchmark:agents:test": "pnpm --dir benchmarks/agents test",
    "benchmark:agents:run": "pnpm --dir benchmarks/agents benchmark",
    "benchmark:agents:score": "pnpm --dir benchmarks/agents score"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
