{
  "name": "logic2b",
  "version": "1.0.0-rc.3",
  "description": "CLI for logic2b ui \u2014 add copy-paste components to your project.",
  "type": "module",
  "bin": {
    "logic2b": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "logic2b",
    "ui",
    "components",
    "registry",
    "cli",
    "tailwind",
    "design-system"
  ],
  "homepage": "https://ui.logic2b.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amariner/logic2b-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/amariner/logic2b-ui/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:scaffold": "node --import tsx scripts/verify-scaffold.mts",
    "prepack": "tsup",
    "consumer:prepare": "node --import tsx scripts/verify-consumer.mts prepare",
    "test:consumer": "node --import tsx scripts/verify-consumer.mts check",
    "test:verify-browser": "node --import tsx --test test-browser/verify.test.ts",
    "journey:prepare": "node --import tsx scripts/verify-customer-journey.mts prepare",
    "journey:build": "node --import tsx scripts/verify-customer-journey.mts build",
    "journey:change": "node --import tsx scripts/verify-customer-journey.mts change",
    "journey:update": "node --import tsx scripts/verify-customer-journey.mts update",
    "test:journey": "node --import tsx scripts/verify-customer-journey.mts check"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "13.1.0",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@logic2b/registry": "workspace:*",
    "@logic2b/review": "workspace:*",
    "@logic2b/scaffold": "workspace:*",
    "@logic2b/tokens": "workspace:*",
    "@types/node": "^26.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "playwright": "1.61.1",
    "@axe-core/playwright": "4.12.1"
  }
}
