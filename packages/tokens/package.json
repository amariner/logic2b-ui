{
  "name": "@logic2b/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for the logic2b ui theme data: base scales, accents, chart ramps, radii, fonts, the preset codec and the CSS emitters.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contrast": "./src/contrast.ts",
    "./export": "./src/export.ts",
    "./lint": "./src/lint.ts"
  },
  "scripts": {
    "build": "tsx scripts/build-platforms.ts",
    "lint": "tsc --noEmit -p tsconfig.json && tsx scripts/check-platforms.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "style-dictionary": "5.5.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
